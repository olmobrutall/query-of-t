{
	"version": "2.0.0",
	"tasks": [
		{ /*Quote transformer*/
			"label": "tsc: build - quote-transformer-test",
			"type": "typescript",
			"tsconfig": "quote-transformer-test/tsconfig.json",
			"problemMatcher": [
				"$tsc"
			],
			"group": "build",
			"dependsOn": [
				"tsc: build (quote-transformer)" //"install (quote-transformer-test)"
			]
		},
		{
			"label": "install (quote-transformer-test)",
			"type": "npm",
			"script": "install",
			"options": {
				"cwd": "${workspaceFolder}/quote-transformer-test/"
			},
			"dependsOn": [
				"tsc: build (quote-transformer)"
			]
		},
		{
			"label": "tsc: build (quote-transformer)",
			"type": "typescript",
			"tsconfig": "quote-transformer/tsconfig.json",
			"problemMatcher": [
				"$tsc"
			],
			"group": "build",
		},
		{ /*My App*/
			"label": "npm build (my-app)",
			"type": "npm",
			"script": "build",
			"problemMatcher": [
				"$tsc"
			],
			"group": "build",
			"options": {
				"cwd": "${workspaceFolder}/my-app/"
			},
			"dependsOn": [
				"install my-app"
			]
		},
		{
			"label": "build-my-app-debug",
			"type": "shell",
			"command": "npm run --workspace=query-of-t patch-ts; npm run --workspace=query-of-t build; npm run --workspace=example build",
			"problemMatcher": [
				"$tsc"
			],
			"group": "build"
		},
		{
			"label": "install my-app",
			"type": "npm",
			"script": "install",
			"options": {
				"cwd": "${workspaceFolder}/my-app/"
			},
			"dependsOn": [
				"build (query-of-t)"
			]
		},
		{
			"label": "build (query-of-t)",
			"type": "npm",
			"script": "build",
			"options": {
				"cwd": "${workspaceFolder}/query-of-t/"
			},
			"problemMatcher": [
				"$tsc"
			],
			"group": "build",
			"dependsOn": [
				"patch-ts (query-of-t)"
			]
		},
		{
			"label": "patch-ts (query-of-t)",
			"type": "npm",
			"script": "patch-ts",
			"options": {
				"cwd": "${workspaceFolder}/query-of-t/"
			}
		},
	]
}